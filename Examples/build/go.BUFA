# A virtual dir toolchain provider like build/java: a pinned Go distribution, unpacked once, linked into every consumer
# (largeOutput). The script writes BUFA.env, and every dir listing /build/go in deps.bld gets a PATH with go's bin on
# it, hermetic GOFLAGS, and Go's caches inside this dir's persistent cache dir (deps.cacheDir) — one module and build
# cache shared by all consumers, surviving every sandbox wipe.
# ${BUFA_BUILD_ROOT} and ${BUFA_CACHE_ROOT} stay references (expanded in the consumer); only the relative
# BUFA_BUILD_DIR and BUFA_CACHE_DIR are baked in.

largeOutput = true
deps.cacheDir = true

[env]
GO_VER = "go1.27.1"

[windows]
shell = "cmd"
cmd = '''
tar -xf go.zip --strip-components=1
if ERRORLEVEL 1 exit /b %ERRORLEVEL%

rem Into the distribution's own go.env: this Go never downloads another toolchain, whoever runs it.
set GOENV=%CD%\go.env
bin\go env -w GOTOOLCHAIN=local
if ERRORLEVEL 1 exit /b %ERRORLEVEL%

echo PATH=${BUFA_BUILD_ROOT}\%BUFA_BUILD_DIR%\bin;${PATH}> BUFA.env
echo GOFLAGS=-trimpath -buildvcs=false>> BUFA.env
echo GOCACHE=${BUFA_CACHE_ROOT}\%BUFA_CACHE_DIR%\GoCache>> BUFA.env
echo GOPATH=${BUFA_CACHE_ROOT}\%BUFA_CACHE_DIR%\GoPath>> BUFA.env
echo GOMODCACHE=${BUFA_CACHE_ROOT}\%BUFA_CACHE_DIR%\GoModCache>> BUFA.env
'''

[[windows.deps.ext]]
url  = "https://go.dev/dl/${GO_VER}.windows-amd64.zip"
hash = "Fd2iii7fwqtfcdiqkeyea7gbolhjodoo7lg4t7qs6ewkzcq24gh3a"
name = "go.zip"
large = true

[unix]
shell = "bash"
cmd = '''
set -eu
tar -xzf go.tgz --strip-components=1

# Into the distribution's own go.env: this Go never downloads another toolchain, whoever runs it.
GOENV=$PWD/go.env bin/go env -w GOTOOLCHAIN=local

echo "PATH=\${BUFA_BUILD_ROOT}/$BUFA_BUILD_DIR/bin:\${PATH}" > BUFA.env
echo "GOFLAGS=-trimpath -buildvcs=false" >> BUFA.env
echo "GOCACHE=\${BUFA_CACHE_ROOT}/$BUFA_CACHE_DIR/GoCache" >> BUFA.env
echo "GOPATH=\${BUFA_CACHE_ROOT}/$BUFA_CACHE_DIR/GoPath" >> BUFA.env
echo "GOMODCACHE=\${BUFA_CACHE_ROOT}/$BUFA_CACHE_DIR/GoModCache" >> BUFA.env
'''

[[linux.deps.ext]]
url  = "https://go.dev/dl/${GO_VER}.linux-amd64.tar.gz"
hash = "Fwyqsgm2j5gbvr54sjbhiz5kszluiote6v2uaubsu5qi7etbk6fja"
name = "go.tgz"
large = true

[[macos.deps.ext]]
url  = "https://go.dev/dl/${GO_VER}.darwin-arm64.tar.gz"
hash = "Fijdljmry7cc343n4fncoih4fa6dc4phslsbxdi3i3aoibwupsswq"
name = "go.tgz"
large = true
