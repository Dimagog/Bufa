# prefix-dev/shell ships only as a conda package: a zip holding zstd tarballs. Windows' native tar reads both, and
# the pipe keeps the inner tarball out of the output. No stock Linux or macOS tool opens the zstd layer, so there
# the unpacker is pinned too: micromamba, one static binary per platform.
largeOutput = true

[env]
SHELL_VER = "0.2.0"

[windows]
shell = "cmd"
cmd = 'tar -xOf shell.conda pkg-shell-%SHELL_VER%-%SHELL_BUILD%.tar.zst | tar -xf - --strip-components=1 bin/shell.exe'

[windows.env]
SHELL_BUILD = "ha073cba_0"

[[windows.deps.ext]]
url  = "https://conda.anaconda.org/conda-forge/win-64/shell-${SHELL_VER}-${SHELL_BUILD}.conda"
hash = "F5bvfmvvz7h43zpecqqpfy2geivpviyd7inxvpnhn6ymkjzktwq6q"
name = "shell.conda"
large = true

# install, not chmod: the staged micromamba is a link to a read-only cache entry with no exec bit
[unix]
shell = "bash"
cmd = '''
set -euo pipefail

install -m 755 micromamba "$TMPDIR/micromamba"
"$TMPDIR/micromamba" package extract shell.conda pkg
mv pkg/bin/shell .
rm -r pkg
'''

[unix.env]
MAMBA_VER = "2.9.0-0"

